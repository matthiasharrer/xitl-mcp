# Copy to .env for local development (path is relative to apps/api).
DATABASE_URL="file:./prisma/dev.db"
# Production: DATABASE_URL="file:/data/xitl.db"

# API port (defaults to 3002 if unset).
# PORT=3002

# Production only: directory with the built SPA (apps/web/dist).
# WEB_DIST=/app/apps/web/dist

# MCP endpoints (/mcp/<slug>) are mounted only when this is set. It is the HMAC
# secret that signs the stateless OAuth codes/tokens; it is NEVER accepted as a
# bearer. Generate with: openssl rand -base64 32
# Rotating it invalidates every issued token (clients must re-authorize).
# MCP_TOKEN=

# Optional: this server's public origin, when the ingress doesn't send
# X-Forwarded-Proto/-Host (used in OAuth metadata and endpoint URLs).
# PUBLIC_URL=https://xitl.example.org

# Optional admin override for the outbound address policy (ADR-0020). Normally
# not needed: users confirm internal upstream URLs per upstream in the UI
# ("Trotzdem erlauben"). Entries here (host or host:port, comma-separated, IPv6
# as [::1]:3210) skip the check for every user and for push. Empty = strict.
# OUTBOUND_ALLOW_PRIVATE=haushalt.example.org,rezepte.example.org

# Intent summary (ADR-0025): an advisory "what does this call do" per tool
# call from an OpenAI-compatible LLM (llama.cpp). Unset = off. Never on the
# decision path: if the model is slow, down or wrong, calls behave as without.
# Call arguments and tool descriptions are sent to this endpoint. Its host:port
# is the one internal address the request may reach (ADR-0020).
# INTENT_LLM_URL=http://llama-cpp.ai.svc.cluster.local:8080
# Model id; default `qwen`, a llama.cpp alias (the version is not hardcoded).
# The model name the server answers with is stored per call.
# INTENT_LLM_MODEL=qwen
# Optional bearer for the endpoint (never logged).
# INTENT_LLM_API_KEY=
# Request timeout in ms (default and maximum 60000).
# INTENT_LLM_TIMEOUT_MS=60000
# Thinking tokens per request (ADR-0025 amendment): default 128 (measured
# ~4-5 s per call on the cluster Qwen), 0 = thinking off (~1.5 s, less
# precise), capped at 1024; anything unparsable or negative = 128. Sent as
# llama.cpp's `thinking_budget_tokens`; only the answer, never the thinking,
# is parsed or stored.
# INTENT_LLM_THINK_BUDGET=128
# Tests only: INTENT_LLM_STUB=1 uses the deterministic stub model instead
# (INTENT_LLM_STUB_LOG=<file> records its requests). Never in production.
