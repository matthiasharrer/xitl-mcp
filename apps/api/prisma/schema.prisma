// Prisma schema for xitl. SQLite (WAL mode enabled at runtime in src/db.ts).
// The connection URL lives in prisma.config.ts; the app connects through a
// driver adapter built from DATABASE_URL (src/db.ts).

// Output is under apps/api/src so tsc compiles it into dist/generated/prisma.
// It's gitignored build output — regenerate with `npm run db:generate`.
// moduleFormat/importFileExtension are explicit because the compiled output
// runs as plain Node ESM, where relative imports need a `.js` extension.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

/// A person, created on first request from the Authelia Remote-* headers.
/// Accounts are completely separate (ADR-0010): every other model hangs off a
/// user, and every query is scoped by userId.
model User {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  displayName       String
  email             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  upstreams         Upstream[]
  mcpClients        McpClient[]
  snoozes           Snooze[]
  auditEntries      AuditEntry[]
  pushSubscriptions PushSubscription[]
  mcpSessions       McpSession[]
}

enum Policy {
  ALLOW
  ASK
  DENY
}

enum UpstreamAuth {
  OAUTH
  HEADER
  NONE
}

enum UpstreamStatus {
  NOT_CONNECTED
  CONNECTED
  NEEDS_RECONNECT
}

/// An upstream MCP server (Streamable HTTP only, ADR-0013), owned by one user.
/// Two users wanting Haushalt each have their own row and their own tokens.
/// slug is the path segment in /mcp/<slug> and the tool prefix in /mcp
/// (ADR-0014). Credentials are stored as-is (unencrypted, like the audit,
/// ADR-0008) and must never reach an agent, the UI after entry, or a log.
model Upstream {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  url           String
  description   String?
  defaultPolicy Policy         @default(ASK)
  auth          UpstreamAuth   @default(OAUTH)
  status        UpstreamStatus @default(NOT_CONNECTED)

  /// OAUTH: xitl's client registration at the upstream's AS (DCR result) and
  /// the discovered AS metadata, both JSON; the user's tokens.
  oauthClient   String?
  oauthMetadata String?
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  /// OAUTH, in flight: PKCE verifier + state of a started connect flow.
  pendingAuth   String?

  /// HEADER: a static header injected on every upstream request.
  headerName    String?
  headerValue   String?

  /// The upstream's own server instructions, last seen (ADR-0014).
  instructions  String?

  /// ADR-0020: the user confirmed ("Trotzdem erlauben") that this upstream's
  /// URL may be an internal address. Set only if the URL really was internal
  /// at save time; recomputed on every URL change. Allows exactly the URL's
  /// own host:port (lib/outbound.ts upstreamAllowance), nothing else.
  allowInternal Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tools         KnownTool[]
  snoozes       Snooze[]
  auditEntries  AuditEntry[]
  tokenClients  McpClient[]
  mcpSessions   McpSession[]

  @@unique([userId, slug])
}

/// A tool seen in the upstream's tools/list. acknowledgedAt null = new tool:
/// policy ASK whatever the default says, until the user has looked at it
/// (ADR-0004). policy null = use the upstream default. annotations is the
/// upstream's ToolAnnotations JSON (readOnlyHint, destructiveHint, ...).
model KnownTool {
  id             Int          @id @default(autoincrement())
  upstreamId     Int
  upstream       Upstream     @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  annotations    String?
  policy         Policy?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  acknowledgedAt DateTime?
  /// Set when a known tool's description or annotations changed ("rug pull",
  /// TC-36): acknowledgedAt is cleared at the same time, the tool is ASK
  /// ("changed-tool") even over an explicit tool/client ALLOW (lib/policy.ts),
  /// and the UI says "Geändert" instead of "Neu". Cleared again when the user
  /// acknowledges or sets a policy. Also set for every tool of an upstream
  /// whose URL changes (ADR-0021).
  changedAt      DateTime?
  clientPolicies ClientToolPolicy[]

  @@unique([upstreamId, name])
}

/// Per-client override of a tool's policy (ADR-0004), e.g. stricter for one agent.
model ClientToolPolicy {
  id          Int       @id @default(autoincrement())
  toolId      Int
  tool        KnownTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  mcpClientId Int
  mcpClient   McpClient @relation(fields: [mcpClientId], references: [id], onDelete: Cascade)
  policy      Policy

  @@unique([toolId, mcpClientId])
}

/// "Don't ask again for this client + tool until": set when approving (ADR-0004).
model Snooze {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  upstreamId  Int
  upstream    Upstream  @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  /// TOOL: just `toolName`; READONLY: every tool of the upstream whose stored
  /// annotations say readOnlyHint; UPSTREAM: every tool of the upstream.
  /// toolName is null for the two wide scopes. Still only ever ASK -> ALLOW,
  /// never for new/changed tools (policy.ts).
  scope       SnoozeScope @default(TOOL)
  toolName    String?
  mcpClientId Int
  mcpClient   McpClient @relation(fields: [mcpClientId], references: [id], onDelete: Cascade)
  until       DateTime
  createdAt   DateTime  @default(now())

  @@index([userId, upstreamId, toolName, mcpClientId])
}

enum SnoozeScope {
  TOOL
  READONLY
  UPSTREAM
}

enum McpClientKind {
  OAUTH
  TOKEN
}

/// An inbound MCP client. OAUTH (ADR-0012, copied from Haushalt ADR-0006): only
/// clients are rows; codes and tokens are stateless signed blobs; userId is null
/// until someone approves the consent page; then it's that user, for good.
/// TOKEN (ADR-0015): a per-upstream access token; userId and upstreamId are set
/// at creation, only sha256(token) is stored (tokenHash) plus a recognition
/// prefix. A TOKEN row never takes part in the OAuth flows.
model McpClient {
  id             Int                @id @default(autoincrement())
  clientId       String             @unique
  name           String
  redirectUris   String
  kind           McpClientKind      @default(OAUTH)
  userId         Int?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  upstreamId     Int?
  upstream       Upstream?          @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  /// TOKEN scope (ADR-0018): true = all of the user's upstreams (upstreamId
  /// must then be null); false = the one upstream in upstreamId.
  allUpstreams   Boolean            @default(false)
  tokenHash      String?            @unique
  tokenPrefix    String?
  createdAt      DateTime           @default(now())
  lastUsedAt     DateTime?
  toolPolicies   ClientToolPolicy[]
  snoozes        Snooze[]
  auditEntries   AuditEntry[]
  mcpSessions    McpSession[]

  @@index([userId])
}

enum CallOutcome {
  PENDING
  FORWARDED
  DENIED
  TIMED_OUT
  UPSTREAM_ERROR
}

/// One row per tools/call that reached the proxy (ADR-0008), unredacted.
/// decisionPath says how the decision was made: "policy:upstream-default",
/// "policy:tool", "policy:client", "new-tool", "changed-tool", "snooze",
/// "approved:push", "approved:page", "denied:page", "timeout", "revoked",
/// "flood", ... endpoint is "/mcp/<slug>"
/// or "/mcp".
model AuditEntry {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpClientId  Int?
  mcpClient    McpClient?  @relation(fields: [mcpClientId], references: [id], onDelete: SetNull)
  upstreamId   Int?
  upstream     Upstream?   @relation(fields: [upstreamId], references: [id], onDelete: SetNull)
  endpoint     String
  toolName     String
  arguments    String
  policy       Policy
  decisionPath String
  outcome      CallOutcome @default(PENDING)
  isError      Boolean?
  resultText   String?
  receivedAt   DateTime
  decidedAt    DateTime?
  finishedAt   DateTime?
  /// The pending approval's unguessable id (approval/pending.ts) when the
  /// call was held for a decision (ASK). Lets the API answer 409 "nicht mehr
  /// offen" and the deep-link page show the outcome after the call resolved.
  approvalId   String?     @unique
  /// The MCP session the call came in on (ADR-0016), null for sessionless
  /// clients. The session is diagnostics, never authority.
  sessionId    String?
  session      McpSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// Per-request diagnostics (sessions.requestDiagnostics), so calls can be
  /// told apart without a session: untrusted, clipped, header NAMES only.
  protocolVersion String?
  clientInfo      String?
  userAgent       String?
  /// JSON arrays of names.
  headerNames     String?
  metaKeys        String?
  /// Grouping candidates (Claude.ai has no sessions, 2026-07-28): trace ids
  /// of `traceparent` / `x-cloud-trace-context`, `x-anthropic-client` value.
  traceId         String?
  cloudTraceId    String?
  anthropicClient String?

  @@index([userId, receivedAt])
  @@index([sessionId])
}

/// One MCP session on /mcp/<slug> (ADR-0016): created on a 2025-era
/// `initialize`, its id sent back as `Mcp-Session-Id`. NOT a credential: every
/// request still needs a valid bearer, and a session is only accepted from its
/// own user + client + upstream (mcp/sessions.ts). 2026-07-28-era clients have
/// no sessions at all and stay sessionless. Diagnostics for MG-06: header
/// NAMES (never values) and `_meta` keys seen, as JSON arrays; the only header
/// values kept are User-Agent and the protocol version.
model McpSession {
  /// 256 random bits, base64url (also the Mcp-Session-Id value).
  id              String       @id
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpClientId     Int
  mcpClient       McpClient    @relation(fields: [mcpClientId], references: [id], onDelete: Cascade)
  /// null: a session on the unified `/mcp` (ADR-0017), not on one upstream.
  upstreamId      Int?
  upstream        Upstream?    @relation(fields: [upstreamId], references: [id], onDelete: Cascade)
  /// initialize.params.clientInfo (untrusted, length-capped).
  clientName      String?
  clientVersion   String?
  /// initialize.params.protocolVersion as the client asked for it.
  protocolVersion String?
  userAgent       String?
  /// JSON array of lower-cased request header names (union over the session).
  headerNames     String       @default("[]")
  /// JSON array of `_meta` keys seen in tools/call params (union).
  metaKeys        String       @default("[]")
  callCount       Int          @default(0)
  createdAt       DateTime
  lastSeenAt      DateTime
  endedAt         DateTime?
  auditEntries    AuditEntry[]

  @@index([userId, createdAt])
}

/// Small key/value store for server-generated settings (the VAPID key pair under "vapid").
model AppSetting {
  key   String @id
  value String
}

/// One browser/device that can receive Web Push (ADR-0009), copied from Haushalt.
model PushSubscription {
  id            Int       @id @default(autoincrement())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}
